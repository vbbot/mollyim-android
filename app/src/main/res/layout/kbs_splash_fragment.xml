<?xml version="1.0" encoding="utf-8"?>
<!--
  The PIN migration splash, in the Light Phone III design language.

  Composed by `LightSvrSplashView`; this file exists only to name it. The previous version held a
  Material `Toolbar`, a Material `Button` pair, `TextView`s on Signal's type scale, and the
  `ic_kbs_splash` illustration, a full-colour vector with no honest rendering on a monochrome panel
  and no reference from the fragment that used to inflate this layout.
-->
<org.thoughtcrime.securesms.lock.v2.LightSvrSplashView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/light_svr_splash_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:viewBindingIgnore="true" />
