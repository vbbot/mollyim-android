<?xml version="1.0" encoding="utf-8"?>
<!--
  "Enter your Signal PIN", in the Light Phone III design language.

  This is the same screen the create and confirm PIN screens are, so it is the same view: the top
  bar, the title and body copy, the credential field and its status line, the keyboard switch, the
  "need help" action, the confirm action and the failure notice are all composed by
  `LightSvrPinView`, which is where the grid sizing and the SDK components live. This file exists
  only to name it in XML.

  The previous version of this file was a ScrollView holding a `ConstraintLayout` around a title, a
  description, a Material `TextInputLayout` around the credential field, a status label and four
  `MaterialButton`s, every margin and constraint expressed in raw dp. The credential field itself
  still exists, as a real `EditText` owned by `LightSvrPinView`, because a PIN is entered on the
  system IME, which the LP3 supplies.

  One thing this file can no longer express, because it never had a way to: the multi-tap on the
  title that submitted a debug log. It needed a title `TextView` by id. The create and confirm PIN
  screens lost the same affordance when they moved to this view.
-->
<org.thoughtcrime.securesms.lock.v2.LightSvrPinView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/light_svr_pin_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:viewBindingIgnore="true" />