<?xml version="1.0" encoding="utf-8"?>
<!--
  The periodic PIN reminder's content, in the Light Phone III design language.

  Built by `LightPinReminderView`, which is where the Light type scale, the grid spacing and the
  rule under the credential field live; this file exists only to name it in XML, so that
  `SignalPinReminderDialog.setView(R.layout.kbs_pin_reminder_view)` keeps working. The previous
  version was a ConstraintLayout holding Signal-styled TextViews, a `NoAutofillEditText` with 40dp of
  padding and a 105sp minimum width, and a pair of Material buttons.

  What did not change is what that dialog does with it: it still looks up `pin`, `pin_status`,
  `kbs_reminder_body`, `skip` and `submit` by id, still chooses the keyboard type itself from
  `SignalStore.pin().getKeyboardType()`, and still attaches its own text watcher. Those ids are
  declared in `res/values/ids.xml` now that no layout mentions them.

  The dialog's window is still Material's; `SignalPinReminderDialog` is outside this change.
-->
<org.thoughtcrime.securesms.light.LightPinReminderView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:viewBindingIgnore="true" />
