<?xml version="1.0" encoding="utf-8"?>
<!--
  "You have run out of PIN guesses", in the Light Phone III design language.

  Composed by `LightSvrSplashView`; this file exists only to name it. The previous version held a
  Material `Toolbar`, two `MaterialButton`s and two `TextView`s on Signal's type scale, every margin
  expressed in raw dp, and the primary button wearing a `cta_button_background` drawable that put a
  filled rounded rectangle on what is meant to be a black panel.
-->
<org.thoughtcrime.securesms.lock.v2.LightSvrSplashView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/light_svr_splash_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:viewBindingIgnore="true" />