<?xml version="1.0" encoding="utf-8"?>
<!--
  The Signal PIN create/confirm screen, in the Light Phone III design language.

  Everything this screen draws (the top bar, the title and body copy, the "learn more"
  affordance, the rule under the field, the status line, the two bottom actions and the failure
  notice) is composed by `LightSvrPinView`, which is where the grid sizing and the SDK components
  live. This file exists only to name it in XML, so the fragment's `onCreateView` is a one-liner
  and there is no second place for the layout to be described.

  The previous version of this file was a ScrollView holding a Material `Toolbar`, a Material
  `TextInputLayout` around the credential field, two `MaterialButton`s and a `LearnMoreTextView`,
  all constrained to raw dp. The credential field itself still exists, as a real `EditText` owned by
  `LightSvrPinView`, because a PIN is entered on the system IME, which the LP3 supplies, and because
  that field is the one control on the screen where a reimplementation is not worth the risk.
  Nothing else about it is Signal's.
-->
<org.thoughtcrime.securesms.lock.v2.LightSvrPinView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/light_svr_pin_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:viewBindingIgnore="true" />
