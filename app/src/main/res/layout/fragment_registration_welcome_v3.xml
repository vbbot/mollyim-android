<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="org.thoughtcrime.securesms.registration.ui.welcome.WelcomeFragment">

    <!--
      The welcome screen is the root of the registration graph, so the bar carries no back
      affordance (there is nothing behind it); its centre names the app. Its one action is the network/proxy
      entry, which used to live in a Material overflow menu on a `Toolbar`. It is a visible Light
      icon in the bar's right slot instead, because on a black screen an ellipsis that opens a
      one-item Material popup is the only Material left on the first screen a user ever sees.
    -->
    <org.thoughtcrime.securesms.light.LightTopBarView
        android:id="@+id/light_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The actions, replacing the `MaterialButton`s this screen used to carry.

      The wordmark and the "Take privacy with you" headline that sat above them are gone for good:
      they are Signal's, and the Light port has no wordmark. The view takes the whole body below the
      bar and centres the stack in it, with the terms footnote at the foot, so no part of the screen
      is black for no reason. It sets its own type, colour, hit targets and bottom clearance from the
      grid.
    -->
    <org.thoughtcrime.securesms.registration.ui.welcome.LightWelcomeActionsView
        android:id="@+id/welcome_actions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/light_top_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
