<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.thoughtcrime.securesms.registration.ui.welcome.WelcomeFragment">

    <!--
      The welcome screen is the root of the registration graph, so the bar carries no back
      affordance (there is nothing behind it) and no title. Its one job is the network/proxy
      entry, which used to live in a Material overflow menu on a `Toolbar`. It is a visible Light
      icon in the bar's right slot instead, because on a black screen an ellipsis that opens a
      one-item Material popup is the only Material left on the first screen a user ever sees.
    -->
    <org.thoughtcrime.securesms.light.LightTopBarView
        android:id="@+id/light_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The four actions, replacing the `MaterialButton`s this screen used to carry.

      The wordmark and the "Take privacy with you" headline that sat above them are gone for good:
      they are Signal's, and the Light port has no wordmark. What is left is black and this stack,
      anchored to the bottom, so the screen reads the way the device does everywhere else.

      The rows set their own type, colour and hit targets from the grid, so this view is given
      nothing but its position.
    -->
    <org.thoughtcrime.securesms.registration.ui.welcome.LightWelcomeActionsView
        android:id="@+id/welcome_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
