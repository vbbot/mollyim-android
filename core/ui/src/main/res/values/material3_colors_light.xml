<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LIGHT PHONE MONOCHROME PALETTE.

        `values/material3_colors.xml` aliases the un-suffixed `signal_color*` names to these
        `signal_light_*` roles, and `values-night/material3_colors.xml` aliases the very same names
        to the `signal_dark_*` roles in material3_colors_dark.xml. Anything that resolves
        `@color/signal_colorNeutral` therefore lands here in day mode and there at night.

        The Light Phone III has no separate day mode, so every role below is set to its
        `signal_dark_*` counterpart: the two files now describe one palette, and the system
        day/night setting cannot change how the app looks. Roles that only exist on this side
        (primary/surface/background/outline) take the matching `molly_*_dark` value from
        molly_colors.xml, which is where the same role is resolved for theme attributes.

        There are no qualifier variants of this file — `values/` is the only copy.
    -->
    <color name="signal_light_colorPrimary">#E9E9E9</color>
    <!-- <color name="signal_light_colorPrimaryContainer">#C1B4FB</color> -->
    <!-- <color name="signal_light_colorSecondary">#C5C1DD</color> -->
