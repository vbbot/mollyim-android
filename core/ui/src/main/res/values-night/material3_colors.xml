<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LIGHT PHONE MONOCHROME PALETTE.

        NOTE: there is a `values-night/` copy of this exact file defining these exact names. Android
        replaces rather than merges qualified resource files, so a change made only here is dead on
        a device in night mode (and vice versa). Both copies are kept in lockstep and both resolve
        to the same monochrome ramp, so the system day/night setting cannot change how the app looks.
    -->

    <!-- Core colors for Material3 -->
    <!-- MOLLY: Colors moved to themes.xml as theme attributes -->
    <color name="signal_neutralSurface">@color/signal_dark_neutralSurface</color>
    <color name="signal_colorOnCustom">@color/signal_dark_colorOnCustom</color>
    <color name="signal_colorOnCustomVariant">@color/signal_dark_colorOnCustomVariant</color>
    <color name="signal_colorTransparent1">@color/signal_dark_colorTransparent1</color>
    <color name="signal_colorTransparent2">@color/signal_dark_colorTransparent2</color>
    <color name="signal_colorTransparent3">@color/signal_dark_colorTransparent3</color>
    <color name="signal_colorTransparent4">@color/signal_dark_colorTransparent4</color>
    <color name="signal_colorTransparent5">@color/signal_dark_colorTransparent5</color>
    <color name="signal_colorNeutral">@color/signal_dark_colorNeutral</color>
    <color name="signal_colorNeutralVariant">@color/signal_dark_colorNeutralVariant</color>
    <color name="signal_colorTransparentInverse1">@color/signal_dark_colorTransparentInverse1</color>
    <color name="signal_colorTransparentInverse2">@color/signal_dark_colorTransparentInverse2</color>
    <color name="signal_colorTransparentInverse3">@color/signal_dark_colorTransparentInverse3</color>
    <color name="signal_colorTransparentInverse4">@color/signal_dark_colorTransparentInverse4</color>
    <color name="signal_colorTransparentInverse5">@color/signal_dark_colorTransparentInverse5</color>
    <color name="signal_colorNeutralInverse">@color/signal_dark_colorNeutralInverse</color>
    <color name="signal_colorNeutralVariantInverse">@color/signal_dark_colorNeutralVariantInverse</color>

    <!-- Inverses -->
    <color name="signal_colorOnSurfaceInverse">@color/molly_on_surface_light</color>
    <color name="signal_colorErrorInverse">@color/molly_error_light</color>
    <color name="signal_colorErrorContainerInverse">@color/molly_error_container_light</color>

    <!-- Core color alpha variants -->
    <color name="signal_colorSecondaryContainer_12">#1F141414</color>
    <color name="signal_colorTertiaryContainer_12">#1F141414</color>
    <color name="signal_colorSurface_60">#99000000</color>
    <color name="signal_colorSurfaceVariant_38">#610F0F0F</color>
    <color name="signal_colorSurfaceVariant_64">#A30F0F0F</color>
    <color name="signal_colorOnSurface_12">#1FE9E9E9</color>
    <color name="signal_colorOnSurface_50">#80E9E9E9</color>
    <color name="signal_colorOnSurfaceVariant_60">#99C6C6C6</color>
    <color name="signal_colorOnBackground_60">#99E9E9E9</color>
    <color name="signal_colorOutline_38">#615E5E5E</color>
    <color name="signal_colorOutlineVariant_38">#61474747</color>
    <color name="signal_colorBackground_0">#00000000</color>

    <!-- Core color alpha variants without alpha channel -->
    <color name="signal_colorSurfaceVariant_16_no_alpha">#141414</color>
    <color name="signal_colorSurfaceVariant_32_no_alpha">#1F1F1F</color>
</resources>